03.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z\",\n  },\n]\n\n// The house gradient, orange through pink to violet, deepened just enough that\n// the white marks keep at least a 3:1 contrast on every tile.\nconst SWEEP_ORANGE = \"#cf711a\"\nconst SWEEP_PINK = \"#d76797\"\nconst SWEEP_VIOLET = \"#9362e4\"\n/** Share of the sweep that runs from orange to pink. Pink to violet takes the rest. */\nconst SWEEP_PINK_AT = 0.4\n/** Where the sweep starts: the top left, in degrees clockwise from the right. */\nconst SWEEP_START = 225\n\n/**\n * The direction of every tile from the centre at rest, in degrees clockwise\n * from the right. The honeycomb puts the first tile in the centre, then fills\n * ring by ring, each ring starting on the right and walking round clockwise.\n */\nfunction restingAngles(count: number) {\n  const angles = [0]\n  for (let ring = 1; angles.length < count; ring++) {\n    for (let step = 0; step < ring * 6 && angles.length < count; step++) {\n      angles.push((step / (ring * 6)) * 360)\n    }\n  }\n  return angles\n}\n\n/**\n * Tints a tile by its direction from the centre, so every ring sweeps from\n * orange at the top left, through pink, to violet at the bottom right, like\n * the centre tile itself.\n */\nfunction sweepTint(angle: number) {\n  const turn = (((angle - SWEEP_START) % 360) + 360) % 360\n  // 0 at the top left, 1 at the bottom right, whichever way round the ring.\n  const share = Math.min(turn, 360 - turn) / 180\n  if (share <= SWEEP_PINK_AT) {\n    const pink = Math.round((share / SWEEP_PINK_AT) * 100)\n    return `color-mix(in oklch, ${SWEEP_PINK} ${pink}%, ${SWEEP_ORANGE})`\n  }\n  const violet = Math.round(\n    ((share - SWEEP_PINK_AT) / (1 - SWEEP_PINK_AT)) * 100\n  )\n  return `color-mix(in oklch, ${SWEEP_VIOLET} ${violet}%, ${SWEEP_PINK})`\n}\n\n// One tint per tile. The centre tile keeps the full house gradient instead.\nconst tints = restingAngles(integrations.length + 1).map(sweepTint)\n\nconst features = [\n  \"Sync issues and pull requests both ways\",\n  \"Get deploy and error alerts where your team talks\",\n  \"Add a new tool in minutes, not sprints\",\n]\n\nfunction BrandMark({ path }: { path: string }) {\n  return (\n    <svg\n      viewBox=\"0 0 24 24\"\n      fill=\"currentColor\"\n      aria-hidden=\"true\"\n      className=\"size-2/5\"\n    >\n      <path d={path} />\n    </svg>\n  )\n}\n\nfunction ProductMark() {\n  return (\n    <svg\n      viewBox=\"0 0 24 24\"\n      fill=\"currentColor\"\n      fillRule=\"evenodd\"\n      aria-hidden=\"true\"\n      className=\"size-4/7\"\n    >\n      <path d=\"M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9zm0 4.5L8.1 9.75v4.5L12 16.5l3.9-2.25v-4.5z\" />\n    </svg>\n  )\n}\n\nfunction CheckMark() {\n  return (\n    <svg\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth={2}\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n      className=\"text-muted-foreground size-4 shrink-0\"\n    >\n      <path d=\"M20 6 9 17l-5-5\" />\n    </svg>\n  )\n}\n\nexport default function IconHoneycombDemo2() {\n  return (\n    <section className=\"bg-background text-foreground grid w-full items-center gap-8 px-6 py-10 md:grid-cols-2 md:px-12\">\n      <div>\n        <p className=\"text-muted-foreground mb-3 text-sm\">Integrations</p>\n        <h2 className=\"text-2xl font-semibold tracking-tight text-balance\">\n          Your whole stack in one release flow\n        </h2>\n        <p className=\"text-muted-foreground mt-4 text-sm leading-relaxed\">\n          Lumora connects your repositories, deploys and alerts, so every change\n          can be traced from the first commit to production.\n        </p>\n        <ul className=\"mt-6 space-y-3 text-sm\">\n          {features.map((feature) => (\n            <li key={feature} className=\"flex items-center gap-2\">\n              <CheckMark />\n              {feature}\n            </li>\n          ))}\n        </ul>\n      </div>\n      <div className=\"border-border min-w-0 rounded-xl border\">\n        <IconHoneycomb\n          className=\"h-[340px] md:h-[420px]\"\n          aria-label=\"Lumora integrations\"\n        >\n          <button\n            type=\"button\"\n            aria-label=\"Lumora\"\n            className=\"bg-linear-to-br/oklch from-[#e8801a] to-[#9c40ff] text-white\"\n          >\n            <ProductMark />\n          </button>\n          {integrations.map(({ name, path }, index) => (\n            <button\n              key={name}\n              type=\"button\"\n              aria-label={name}\n              style={{ backgroundColor: tints[index + 1] }}\n              className=\"text-white\"\n            >\n              <BrandMark path={path} />\n            </button>\n          ))}\n        </IconHoneycomb>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
